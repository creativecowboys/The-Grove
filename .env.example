# The Grove — contact form (/api/inquiry)
# Set these in the Vercel project (Settings → Environment Variables). Never commit real values.

# --- Email side (Resend) ---
# Resend API key from resend.com. Reuse the Creative Cowboys account key.
RESEND_API_KEY=
# Verified sender. creativecowboys.co is already verified in Resend, so this works as-is.
INQUIRY_FROM_EMAIL="The Grove Website <inquiries@creativecowboys.co>"
# Where inquiry notifications land (the venue's inbox).
INQUIRY_NOTIFY_EMAIL=info@thegroveatdefoorfarm.com

# --- GoHighLevel side (opportunity) ---
# Private Integration token: GHL → Settings → Private Integrations → create one with
# contacts.write + opportunities.write scopes.
GHL_API_TOKEN=
# Sub-account id: GHL → Settings → Business Profile (or the location URL).
GHL_LOCATION_ID=KpXr13pfWaxr88kBGAcr
# Pipeline the new lead should land in: GHL → Opportunities → Pipelines.
GHL_PIPELINE_ID=xvvYGS6wxtT2TNewiWfI
# Stage within that pipeline (matched by name at runtime). Optional — defaults
# to "New Lead", and falls back to the pipeline's first stage if not found.
GHL_STAGE_NAME=New Lead
